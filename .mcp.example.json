{
  "mcpServers": {
    "ChromeDevToolsMCP": {
      "args": ["/c", "npx", "-y", "chrome-devtools-mcp@latest"],
      "command": "cmd",
      "env": {}
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "env": {
        "CONTEXT7_API_KEY": "your-context7-api-key-here"
      }
    }
  }
}
